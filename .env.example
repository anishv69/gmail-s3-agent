S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# Use a long random value. The scheduler sends it as a Bearer token.
CRON_SECRET=""
# First run imports inbox messages from the last N days.
GMAIL_LOOKBACK_DAYS="30"
MAX_ATTACHMENT_MB="25"
GMAIL_SYNC_ENABLED="true"
GMAIL_SYNC_INTERVAL_MS="60000"

# Optional isolated sender account for the bounded demo email script.
# Authorize this separate account with Gmail API scope gmail.send.
DEMO_SENDER_EMAIL=""
DEMO_GOOGLE_CLIENT_ID=""
DEMO_GOOGLE_CLIENT_SECRET=""
DEMO_GOOGLE_REFRESH_TOKEN=""

# Optional AI assistant. Document text is sent to OpenAI only after indexing is started.
OPENAI_API_KEY=""
AI_CHAT_MODEL="gpt-4.1-mini"

# Protects all non-API pages with HTTP Basic authentication in production.
DASHBOARD_USERNAME=""
DASHBOARD_PASSWORD=""
